# Uygulama çalıştırılırken gerçek değer secret manager veya yerel .env.local'dan gelir.
DATABASE_URL=postgresql://reklamzeka:reklamzeka@localhost:5432/reklamzeka
# 32 byte anahtarın base64 karşılığı; gerçek değer yalnız secret manager/.env.local içindedir.
SECRET_ENCRYPTION_KEY=
# En az 32 byte rastgele anahtarın standart base64 karşılığı; süreli rapor tokenlarını HMAC-SHA256 ile imzalar.
REPORT_SIGNING_KEY=
# Meta Graph bağlantısı yalnız yerel .env.local/secret manager üzerinden verilir; gerçek token commit edilmez.
META_ACCESS_TOKEN=
META_TOKEN_SECURITY_STATUS=standard
