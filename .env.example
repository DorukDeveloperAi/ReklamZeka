# Uygulama çalıştırılırken gerçek değer secret manager veya yerel .env.local'dan gelir.
DATABASE_URL=postgresql://reklamzeka:reklamzeka@localhost:5432/reklamzeka
# Migration/pg_dump için direct veya IPv4 uyumlu session-pooler bağlantısı.
DIRECT_DATABASE_URL=postgresql://reklamzeka:reklamzeka@localhost:5432/reklamzeka
# 32 byte anahtarın base64 karşılığı; gerçek değer yalnız secret manager/.env.local içindedir.
SECRET_ENCRYPTION_KEY=
# En az 32 byte rastgele anahtarın standart base64 karşılığı; süreli rapor tokenlarını HMAC-SHA256 ile imzalar.
REPORT_SIGNING_KEY=
# Meta Graph bağlantısı yalnız yerel .env.local/secret manager üzerinden verilir; gerçek token commit edilmez.
META_ACCESS_TOKEN=
META_TOKEN_SECURITY_STATUS=standard
# P08 rollout kapıları exact "true" dışında kapalıdır. Alt aşama bayrakları
# üst aşamaları veya global Meta write kapısını tek başına açamaz.
META_READ_ENABLED=
GUIDE_SCHEDULER_ENABLED=
HUMAN_ACTION_EXECUTION_ENABLED=
LIMITED_AUTONOMY_ENABLED=
META_WRITE_ENABLED=
# Yazma tokenı read tokenından ayrıdır; workspace/account/action allowlistlerinin
# tamamı ve açık kill switch olmadan execution runtime oluşturulmaz.
P06_META_WRITE_ACCESS_TOKEN=
P06_META_WRITE_KILL_SWITCH=true
P06_META_WRITE_WORKSPACE_ALLOWLIST=
P06_META_WRITE_ACCOUNT_ALLOWLIST=
P06_META_STATUS_WRITE_ENABLED=
P06_META_WRITE_ACTION_ALLOWLIST=
P06_META_BUDGET_WRITE_ENABLED=
P06_META_BUDGET_WRITE_ACTION_ALLOWLIST=
# Yerel Decision Room yalnız açıkça etkinleştirilmiş loopback origin ve DB üyeliğine bağlanır.
REKLAMZEKA_LOCAL_SESSION_ENABLED=
REKLAMZEKA_LOCAL_ORIGIN=
REKLAMZEKA_LOCAL_WORKSPACE_ID=
REKLAMZEKA_LOCAL_WORKSPACE_REF=
REKLAMZEKA_LOCAL_USER_ID=
REKLAMZEKA_LOCAL_READER_REF=
# 32 byte rastgele anahtarın standart base64 karşılığı; capability imzaları yalnız server-side üretilir.
REKLAMZEKA_LOCAL_SESSION_SIGNING_KEY=
# Dashboard içi kalıcı Orchestrator sohbeti ayrı ve açık bir local-only valftir.
REKLAMZEKA_ORCHESTRATOR_CODEX_ENABLED=
REKLAMZEKA_GUIDE_RUN_CODEX_ENABLED=
# İstekten alınmaz; server başlangıcında sabitlenen absolute executable ve workspace köküdür.
REKLAMZEKA_CODEX_EXECUTABLE=/Applications/ChatGPT.app/Contents/Resources/codex
REKLAMZEKA_CODEX_WORKSPACE_ROOT=
