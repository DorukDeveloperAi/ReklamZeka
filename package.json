{
  "name": "reklamzeka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Çok kanallı, açıklanabilir reklam karar destek ürünü",
  "scripts": {
    "dev": "next dev",
    "build": "META_ACCESS_TOKEN= REKLAMZEKA_LOCAL_SESSION_SIGNING_KEY= next build && npm run check:secret-artifacts",
    "start": "next start",
    "check:foundation": "node scripts/check-project-foundation.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:model-api-boundary": "node scripts/check-model-provider-boundary.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "check:data": "vitest run tests/data-platform.test.ts tests/schema.test.ts && npm run db:check",
    "check:security-boundaries": "node scripts/check-security-boundaries.mjs && vitest run tests/security-boundaries.test.ts tests/schema.test.ts && npm run db:check",
    "check:experience": "node scripts/check-experience.mjs && vitest run tests/performance-experience.test.ts",
    "check:insights": "node scripts/check-insights.mjs && vitest run tests/insight-engine.test.ts tests/insight-feedback.test.ts tests/schema.test.ts && npm run db:check",
    "check:pilot-web": "node scripts/check-pilot-web.mjs && vitest run tests/pilot-web-journey.test.ts",
    "check:pilot-readiness": "node scripts/check-pilot-readiness.mjs && vitest run tests/report-pilot.test.ts tests/report-runtime.test.ts tests/report-http.test.ts tests/mvp-journey.test.ts tests/field-pilot-input.test.ts tests/pilot-telemetry.test.ts tests/schema.test.ts && npm run db:check",
    "check:analysis-platform": "node scripts/check-analysis-platform.mjs && vitest run tests/analysis-definition.test.ts tests/objective-playbooks.test.ts tests/prompt-envelope.test.ts",
    "pilot:field-preflight": "tsx scripts/preflight-field-pilot.ts",
    "pilot:field-report": "tsx scripts/generate-field-pilot-report.ts",
    "local-session:mint": "tsx --env-file=.env.local scripts/mint-local-session.ts",
    "local-session:configure": "tsx scripts/configure-local-session.ts",
    "mcp:stdio": "node --import tsx scripts/reklamzeka-mcp.ts",
    "verify:mcp-live": "tsx scripts/verify-reklamzeka-mcp-live.ts",
    "verify:guidance-agent-live": "tsx scripts/verify-guidance-agent-mcp-live.ts",
    "verify:guidance-studio-live": "tsx scripts/verify-guidance-studio-postgres.ts",
    "local-workspace:bootstrap": "tsx scripts/bootstrap-local-workspace.ts",
    "verify:local-workspace-bootstrap-db": "tsx scripts/verify-local-workspace-bootstrap-postgres.ts",
    "verify:local-agent-session-db": "tsx scripts/verify-local-agent-session-postgres.ts",
    "verify:local-agent-handoff-http-db": "tsx scripts/verify-local-agent-handoff-http-postgres.ts",
    "check:field-pilot": "node scripts/check-field-pilot.mjs",
    "test": "npm run check:foundation && npm run check:architecture && npm run check:model-api-boundary && npm run check:analysis-platform && npm run typecheck && npm run test:unit",
    "check:quick": "npm test && npm run db:check",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "verify:meta-sync-db": "tsx scripts/verify-meta-sync-postgres.ts",
    "verify:meta-asset-content-db": "tsx scripts/verify-meta-asset-content-postgres.ts",
    "verify:meta-post-media-db": "tsx scripts/verify-meta-post-media-postgres.ts",
    "verify:meta-s14-live-db": "tsx scripts/verify-meta-s14-live-postgres.ts",
    "verify:meta-s14-read": "tsx scripts/verify-meta-s14-read.ts",
    "verify:meta-targeting-shape": "tsx scripts/verify-meta-targeting-shape.ts",
    "verify:meta-insight-capabilities": "tsx scripts/verify-meta-insight-capabilities.ts",
    "verify:meta-change-timeline-db": "tsx scripts/verify-meta-change-timeline-postgres.ts",
    "verify:meta-connection-db": "tsx scripts/verify-meta-connection-postgres.ts",
    "verify:workspace-tombstone-db": "tsx scripts/verify-workspace-tombstone-postgres.ts",
    "verify:category-registry-db": "tsx scripts/verify-category-registry-postgres.ts",
    "verify:category-inventory-live": "node --env-file=.env.local --import tsx scripts/verify-category-inventory-postgres.ts",
    "verify:category-effective-health-live": "node --env-file=.env.local --import tsx scripts/verify-category-effective-health-postgres.ts",
    "verify:category-authoring-live": "node --import tsx scripts/verify-category-authoring-postgres.ts",
    "verify:category-profile-live": "node --import tsx scripts/verify-category-profile-postgres.ts",
    "verify:instruction-policy-live": "node --import tsx scripts/verify-instruction-policy-lifecycle-postgres.ts",
    "verify:progressive-formalization-live": "node --import tsx scripts/verify-progressive-formalization-postgres.ts",
    "verify:starter-category-adoption-live": "node --import tsx scripts/verify-starter-category-adoption-postgres.ts",
    "verify:promotion-template-lifecycle-live": "node --import tsx scripts/verify-promotion-template-lifecycle-postgres.ts",
    "verify:guidance-registry-db": "tsx scripts/verify-guidance-registry-postgres.ts",
    "verify:effective-campaign-context-db": "tsx scripts/verify-effective-campaign-context-postgres.ts",
    "verify:decision-ledger-db": "tsx scripts/verify-decision-ledger-postgres.ts",
    "verify:advised-practice-db": "tsx scripts/verify-advised-practice-postgres.ts",
    "verify:budget-proposal-db": "tsx scripts/verify-budget-proposal-postgres.ts",
    "verify:action-proposal-queue-db": "tsx scripts/verify-action-proposal-queue-postgres.ts",
    "verify:action-guardrail-db": "tsx scripts/verify-action-guardrail-policy-postgres.ts",
    "verify:meta-affected-geo-db": "tsx scripts/verify-meta-affected-geo-postgres.ts",
    "verify:meta-affected-geo-live-db": "tsx scripts/verify-meta-affected-geo-live-postgres.ts",
    "verify:meta-read-sync-schedule-db": "tsx scripts/verify-meta-read-sync-schedule-postgres.ts",
    "verify:decision-room-persistence-db": "tsx scripts/verify-decision-room-persistence-postgres.ts",
    "verify:finding-observation-read-db": "tsx scripts/verify-finding-observation-read-postgres.ts",
    "verify:decision-room-analysis-assets-db": "tsx scripts/verify-decision-room-analysis-assets-postgres.ts",
    "verify:supabase-security": "tsx scripts/verify-supabase-security.ts",
    "check:security": "npm audit --omit=dev",
    "check:secret-artifacts": "node scripts/check-secret-artifacts.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
